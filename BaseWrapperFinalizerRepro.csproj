<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <ApplicationId>com.example.basewrapperrepro</ApplicationId>
    <!-- The app never calls UIApplication.Main, so it needs no scene manifest (MT7199). -->
    <ValidateSceneManifest>false</ValidateSceneManifest>
  </PropertyGroup>
</Project>
